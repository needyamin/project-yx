# Rust
/target/
**/target/

# Node / frontend
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
*.tsbuildinfo

# Dist script cache / staging
/build/
/installer/msix/out/

# Release artifacts — always produced into dist/ (ignored above). These patterns
# are a safety net for a manual `makeappx` / Store upload left at the repo root;
# the packages are hundreds of MB and must never be committed.
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload
*.blockmap
*.sig

# Tauri generated
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/
apps/desktop/src-tauri/nsis/
apps/desktop/src-tauri/bin/

# Local caches / tooling
.proxy-cache/
*.log
debug-*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/
coverage/
*.lcov
.eslintcache
*.pid

# Local agent/scratch notes (same category as context_memory.txt below)
.workbuddy-ai/

# Env / secrets / certificates
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.cer
!apps/desktop/src-tauri/yx-updater.key.pub

# Microsoft Store identity (real values are local-only; commit the .example)
store-identity.json

# Updater signing — private keys only (public .pub may be committed)
apps/desktop/src-tauri/yx-updater.key
apps/desktop/src-tauri/*.key
apps/desktop/src-tauri/tauri-updater-on.json

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# Local notes / scratch (optional personal files)
*.local.md
.scratch/
context_memory.txt

# Benchmarks: harness code is committed, generated media is not
# (regenerate with bundled ffmpeg — see benchmark/README.md)
benchmark/media/

# Project save atomic-write temp files
*.yxp.tmp
