{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project YX",
  "version": "0.1.2",
  "identifier": "com.projectyx.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project YX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#141418"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**",
            "$HOME/**",
            "$DOCUMENT/**",
            "$DOWNLOAD/**",
            "$VIDEO/**",
            "$DESKTOP/**",
            "$PICTURE/**",
            "$APPDATA/**",
            "$LOCALDATA/**",
            "$TEMP/**",
            "$APPCACHE/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "bin/*"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MzQ3OTZBQjBGODE3RDYKUldUV0YvaXdhbmswMUdnT3lzTjZHYnVBYU5Xb3k1R014WHllSWhDSVhPR0kvVldPYndXWE8zR2YK",
      "endpoints": [
        "https://github.com/needyamin/project-yx/releases/latest/download/latest.json"
      ]
    }
  }
}